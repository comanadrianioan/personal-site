# This repository is public: anything below stays on this machine.

# --- Hugo build output and caches
/public/
/resources/
.hugo_build.lock
hugo_stats.json

# --- Local-only content (never published)
# Unfinished posts (`hugo new content writing/drafts/<slug>.md`); the repo is public, so
# `draft: true` alone would not keep them private.
/content/writing/drafts/
# Specs, plans and review reports.
/docs/
# Agent workspaces and local Claude Code settings.
/.superpowers/
/.claude/settings.local.json

# --- Secrets (none are needed to build or deploy; CI uses its own GITHUB_TOKEN)
.env
.env.*
*.pem
*.key

# --- Test and tooling leftovers
node_modules/
coverage/
*.lcov
*.log

# --- OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
